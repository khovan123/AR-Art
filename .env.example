# Default zero-config AR demo.
NEXT_PUBLIC_AR_TARGET_URL=https://cdn.jsdelivr.net/gh/hiukim/mind-ar-js@1.2.5/examples/image-tracking/assets/card-example/card.mind
NEXT_PUBLIC_AR_TARGET_IMAGE_URL=https://cdn.jsdelivr.net/gh/hiukim/mind-ar-js@1.2.5/examples/image-tracking/assets/card-example/card.png
NEXT_PUBLIC_AR_TARGET_INDEX=0
NEXT_PUBLIC_AR_OVERLAY_VIDEO_URL=
NEXT_PUBLIC_AR_OVERLAY_ASPECT_RATIO=1.8116

# Supabase: required for /create, /art/[slug], and /ar/[slug].
# The publishable key is safe to expose in the browser. Never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=ar-art-assets
